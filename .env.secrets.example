# ==============================================================================
# WhatsApp Bot - Secrets & Environment Configuration Template
# Copy this to .env.secrets (or run ./load_env.sh to auto-generate)
# DO NOT COMMIT .env.secrets TO VERSION CONTROL!
# ==============================================================================

# --- One-time Generated Secrets (auto-generated by load_env.sh) ---
# Secret token used by Meta to verify webhook ownership during initial handshake
META_VERIFY_TOKEN="your_generated_verify_token"

# Random salt used for GDPR-compliant hashing of user phone numbers in logs and DB
PII_SALT="your_generated_pii_salt"

# --- Meta / WhatsApp Cloud API Secrets (from Meta Developer Portal) ---
# Found in Meta Developer Portal -> App Settings -> Basic -> App Secret
META_APP_SECRET=""

# Found in Meta Developer Portal -> WhatsApp -> API Setup (Access Token)
META_GRAPH_TOKEN=""

# Found in Meta Developer Portal -> WhatsApp -> API Setup (Phone number ID)
META_PHONE_ID=""

# --- Optional External Services ---
# Required only if NOT using Azure OpenAI with Managed Identity
OPENAI_APIKEY=""

# Required only if Bing Search capability is enabled
BING_API_KEY=""
